# Local authoring credentials. Never commit a populated .env.
EPIDEMICSOUND_API_KEY=

# Read-only R2 S3 credentials and private CI asset location.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ASSET_URI=s3://<bucket>/<object-key>
PRIVATE_GAME_ASSETS_SHA256=
