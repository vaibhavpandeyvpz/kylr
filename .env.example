# Local authoring credentials. Never commit a populated .env.
EPIDEMICSOUND_API_KEY=

# Read-only R2 S3 credentials and private CI asset location.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ASSET_URI=s3://<bucket>/<object-key>
PRIVATE_GAME_ASSETS_SHA256=

# Multiplayer operator configuration (also set these in Render secrets/settings).
MONGO_URI=
JWT_SECRET=
CONTROL_TOKEN=
EDGEGAP_API_KEY=
EDGEGAP_APPLICATION=kylr
EDGEGAP_VERSION=
# Optional on Render: defaults to its RENDER_EXTERNAL_URL.
GAME_API_URL=
EDGEGAP_MAX_DEPLOYMENTS=1
# Public client origin; not a credential.
KYLR_PUBLIC_API_URL=
