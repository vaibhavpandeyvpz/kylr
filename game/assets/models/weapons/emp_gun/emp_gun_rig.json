  "ammo": {
    "mesh": "SM_EmpGunAmmo in emp_gun_ammo.glb, at the AmmoMount gizmo",
    "bone": "Mag",
    "pickup_file": "emp_gun_ammo.glb",
    "pickup_mesh": "SM_EmpGunAmmo",
    "pickup_origin": "its bottom centre, level",
    "axis": [
      0,
      0,
      -1
    ],
    "travel_m": 0.02,
    "note": "mag_release presses the catch and drops the battery out of its dock (its lock post out of the bore); past its travel it is free: hide the battery's mesh and drop a physics copy of the pickup mesh at the Mag bone's transform. To reload, put the battery back at the end of its travel and play mag_insert (the catch snaps into the post's groove)."
  },
  "usage": "idle (loop); fire: fire_start, fire (loop, one pulse a loop), fire_end; reload: mag_release, mag_insert.",
