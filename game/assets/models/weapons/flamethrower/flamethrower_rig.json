  "ammo": {
    "mesh": "SM_FlamethrowerAmmo in flamethrower_ammo.glb, at the AmmoMount gizmo",
    "bone": "Mag",
    "pickup_file": "flamethrower_ammo.glb",
    "pickup_mesh": "SM_FlamethrowerAmmo",
    "pickup_origin": "its bottom centre, lying as under the gun",
    "axis": [
      0,
      0,
      -1
    ],
    "travel_m": 0.03,
    "note": "mag_release presses the catch and drops the pack (two cans on their manifold) off its socket (its neck out of the bore); past MAG_TRAVEL it is free: hide the pack's mesh and drop a physics copy of the pickup mesh at the Mag bone's transform. To reload, put the pack back at the end of its travel and play mag_insert (the catch snaps into the neck's groove)."
  },
  "usage": "idle (loop); fire: fire_start, fire (loop), fire_end; reload: mag_release, mag_insert.",
