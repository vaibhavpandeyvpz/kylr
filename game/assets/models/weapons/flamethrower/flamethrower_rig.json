  "fire": {
    "hold": "fire_start (8 frames: the trigger pulls, the louvres swing open, the gauge drops, the pump starts), then loop fire (30 frames: the pump's rods stroke in turn, the louvres flutter open, the nozzle pulses 1 cm back and home once a second, 15 frames back, 15 home), and on release fire_end (14 frames: everything settles home). Emit the flame stream from Muzzle (forward = its direction) from fire_start's frame 2 through fire; smoke from FumeVent while the louvres are open (fire_start frame 3 to fire_end frame 10).",
    "pilot": "the pilot burns all the time the gun is held (idle, firing, reloading): a small flame at PilotFlame, its forward pointing at the stream ahead of the nozzle; it is what lights the stream as it leaves the nozzle.",
    "idle": "idle (60 frames, loop): the gauge's needle quivers and the pump rods breathe; it starts and ends at rest, as every action except the fire loop (from fire_start, into fire_end).",
    "recoil_m": 0.01,
    "recoil_frames": [
      15,
      15
    ],
    "vent_open_deg": 45,
    "pump_stroke_m": 0.012
  },
