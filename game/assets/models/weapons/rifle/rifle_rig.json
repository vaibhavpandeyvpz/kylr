  "fire": {
    "auto": "fire_start (4 frames: the trigger pulls, the dust cover drops open), then loop fire (12 frames, 4 shots, 600 rounds a minute): a shot on frames [0, 3, 6, 9]: fire the hitscan / spawn the muzzle flash at Muzzle then; the carrier is fully back the frame after each (throw the case from ShellEject, forward = its direction); then fire_end (10 frames: the trigger lets go, the cover closes).",
    "marksman": "scope_in (10 frames: the selector turns to marksman, the optic's sleeve runs 16 mm out to zoom), loop idle_scoped, and fire_marksman per shot (20 frames: the shot on frame 3, the case out on frame 5, the cover opening and closing round it); scope_out to go back. Put the camera on ScopeEye to look through the optic.",
    "reload": "mag_release, mag_insert, then charge (the charging handle pulls the carrier back and lets it run home).",
    "idle": "idle (30 frames, loop) and idle_scoped hold their pose between shots: nothing on the rifle moves at rest; every action starts and ends at rest except the fire loop (from fire_start, into fire_end) and the marksman actions (from scope_in, into scope_out).",
    "cycle_frames": 3,
    "shot_frames": [
      0,
      3,
      6,
      9
    ],
    "bolt_travel_m": 0.06,
    "recoil_m": 0.01,
    "zoom_travel_m": 0.016
  },
