  "fire": {
    "shot": "play fire (single shot, 15 frames): the trigger pulls and cocks the hammer 35 deg (double action) and trips it; it falls on frame 3: fire the hitscan / spawn the muzzle flash at Muzzle then, and puff gas at CompVent. The slide runs 42 mm back (the barrel 1 cm with it), fully back on frame 5: throw the spent case from ShellEject (forward = its direction) then; it is home by frame 12.",
    "last_round": "fire_empty: as fire, but the slide stop rises and holds the slide open 38.7 mm back; after mag_release and mag_insert play slide_release (the slide stop drops, the slide runs home).",
    "idle": "loop idle (30 frames) between shots: it holds the rest pose (nothing on a pistol moves at rest); every action starts and ends at rest except fire_empty, which ends with the slide held open (follow it with the reload and slide_release).",
    "shot_frame": 3,
    "eject_frame": 5,
    "slide_travel_m": 0.042,
    "slide_lock_m": 0.03869,
    "recoil_m": 0.01
  },
