  "ammo": {
    "mesh": "SM_PistolAmmo in pistol_ammo.glb, at the AmmoMount gizmo",
    "bone": "Mag",
    "pickup_file": "pistol_ammo.glb",
    "pickup_mesh": "SM_PistolAmmo",
    "pickup_origin": "its bottom centre, upright",
    "axis": [
      0,
      0,
      -1
    ],
    "rails_m": 0.02,
    "note": "mag_release pulls the catch back and drops the cartridge down its channel; past MAG_TRAVEL it is free: hide the cartridge mesh and drop a physics copy of the pickup mesh at the Mag bone's transform. To reload, put the cartridge back at the end of its travel and play mag_insert (the catch snaps into its notch)."
  },
  "usage": "idle (loop); fire per shot; fire_empty on the last round, then mag_release, mag_insert and slide_release; mag_release / mag_insert alone swap a cartridge with the slide home.",
  "ammo_mount": {
    "gizmo": "AmmoMount",
    "bone": "Mag",
    "model": "pistol_ammo.glb",
    "mesh": "SM_PistolAmmo",
