// Original procedural ribbon shading; mesh geometry is generated by KYLR.
shader_type spatial;
render_mode unshaded, blend_add, cull_disabled, depth_draw_never;
uniform vec4 Tint : source_color = vec4(0.35, 0.7, 1.0, 1.0);
uniform float Intensity = 3.0;
uniform float effect_opacity = 1.0;
instance uniform float progress = 0.0;
varying float fade;
void vertex() {
	VERTEX = vec3(VERTEX.x,VERTEX.z-0.5,VERTEX.y);
	fade = COLOR.a;
}
void fragment() {
	float core = exp(-pow((UV.x - 0.5) * 8.0, 2.0));
	float ends = smoothstep(0.0, 0.06, UV.y) * (1.0 - smoothstep(0.82, 1.0, UV.y));
	ALBEDO = mix(Tint.rgb, vec3(0.85,0.94,1.0),core*0.65) * Intensity;
	EMISSION = mix(Tint.rgb, vec3(0.85, 0.94, 1.0), core * 0.65) * Intensity;
	ALPHA = core * ends * fade * effect_opacity * (1.0-smoothstep(0.1,1.0,progress));
}
